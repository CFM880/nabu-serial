# SPDX-License-Identifier: GPL-2.0-only
# USB CDC-ACM serial debug console.
#
# The configfs ACM function is what userspace exposes as the serial console
# gadget (libexec/nabu-usb-console.sh -> nabu-usb-console.service); with
# console=ttyGS0 on the kernel command line printk reaches the host PC as
# /dev/ttyACM*.  The legacy CONFIG_USB_G_SERIAL is deliberately not used.
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
